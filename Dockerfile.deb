# syntax=docker/dockerfile:1

# Reproducible TomPanel Debian package build.
#
# VERSION and SOURCE_DATE_EPOCH are passed as build args. Binaries are
# compiled with a pinned toolchain, -trimpath, and clamped build metadata;
# the package timestamps follow SOURCE_DATE_EPOCH so two builds from the
# same commit produce identical bytes.

FROM golang:1.26.6-bookworm AS build

ARG VERSION=0.0.0
ARG SOURCE_DATE_EPOCH=946684800

ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64 \
    GOFLAGS=-trimpath \
    -buildvcs=false

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd cmd
COPY internal internal
COPY migrations migrations
COPY web web

RUN mkdir -p /out && \
    for binary in tompaneld tompanel-agent tompanel; do \
        go build -trimpath -buildvcs=false \
            -ldflags="-s -w -X main.buildVersion=${VERSION}" \
            -o /out/usr/lib/tompanel/${binary} ./cmd/${binary}; \
    done

FROM ubuntu:24.04 AS pack

ARG VERSION=0.0.0
ARG SOURCE_DATE_EPOCH=946684800

ENV DEBIAN_FRONTEND=noninteractive \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends dpkg-dev fakeroot \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out /root/pkg
COPY packaging /root/packaging

RUN set -eu; \
    pkg=/root/pkg; \
    mkdir -p "${pkg}/DEBIAN" \
             "${pkg}/etc/tompanel" \
             "${pkg}/etc/nginx/sites-enabled" \
             "${pkg}/usr/lib/tmpfiles.d" \
             "${pkg}/usr/lib/systemd/system" \
             "${pkg}/etc/logrotate.d" \
             "${pkg}/usr/share/doc/tompanel"; \
    cp /root/packaging/systemd/tompanel.service "${pkg}/usr/lib/systemd/system/"; \
    cp /root/packaging/systemd/tompanel-agent.service "${pkg}/usr/lib/systemd/system/"; \
    cp /root/packaging/tmpfiles/tompanel.conf "${pkg}/usr/lib/tmpfiles.d/"; \
    cp /root/packaging/logrotate/tompanel "${pkg}/etc/logrotate.d/tompanel"; \
    sed "s/VERSION_PLACEHOLDER/${VERSION}/" /root/packaging/debian/control > "${pkg}/DEBIAN/control"; \
    cp /root/packaging/debian/postinst "${pkg}/DEBIAN/postinst"; \
    cp /root/packaging/debian/prerm "${pkg}/DEBIAN/prerm"; \
    printf 'TomPanel %s\n\nSee docs/release-signing.md for signature verification.\n' "${VERSION}" > "${pkg}/usr/share/doc/tompanel/README"; \
    find "${pkg}" -exec touch --date="@${SOURCE_DATE_EPOCH}" {} +; \
    chmod 0755 "${pkg}/DEBIAN/postinst" "${pkg}/DEBIAN/prerm"; \
    chmod 0755 "${pkg}/usr/lib/tompanel/tompaneld" \
               "${pkg}/usr/lib/tompanel/tompanel-agent" \
               "${pkg}/usr/lib/tompanel/tompanel"; \
    fakeroot dpkg-deb --build --root-owner-group \
        --uniform-compression -Zxz "${pkg}" "/tmp/tompanel_${VERSION}_amd64.deb"; \
    mkdir -p /out && cp "/tmp/tompanel_${VERSION}_amd64.deb" /out/; \
    cd /out && sha256sum "tompanel_${VERSION}_amd64.deb" > "tompanel_${VERSION}_amd64.deb.sha256"

FROM scratch AS artifact
COPY --from=pack /out/ /
